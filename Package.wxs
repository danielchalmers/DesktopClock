<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="DesktopClock" Manufacturer="Daniel Chalmers" Version="!(bind.FileVersion.DesktopClock.exe)" UpgradeCode="6BD5BA59-2419-4A0E-89F8-C6F8A4EA08F7" Scope="perUser">

    <Icon Id="DesktopClock.ico" SourceFile="DesktopClock\DesktopClock.ico" />

    <Property Id="ARPPRODUCTICON" Value="DesktopClock.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danielchalmers/DesktopClock" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danielchalmers/DesktopClock/issues" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--Skips the System Restore point, which can hold a double-click install at "Please wait" for most of a minute and protects nothing in a per-user app folder-->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <!--The default schedule removes the old version before installing the new one, which a per-user upgrade needs to roll back cleanly. Same-version upgrades let one 0.0.0 build replace another-->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="!(loc.WixDowngradePreventedMessage)" />

    <MediaTemplate EmbedCab="yes" />

    <!--Not WiX's default INSTALLFOLDER under Programs: the settings file lives next to the exe, so moving the app would lose it-->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="DesktopClock" />
    </StandardDirectory>

    <File Id="DesktopClock.exe" Source="publish\$(sys.BUILDARCH)\DesktopClock.exe" />

    <!--Start menu shortcut, which needs a registry key path in a per-user install. Its target is the folder path rather than [#DesktopClock.exe], which ICE69 flags because the exe is in another component. Its component also removes the install folder once it's empty-->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component>
        <Shortcut Name="DesktopClock" Target="[INSTALLFOLDER]DesktopClock.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Daniel Chalmers\DesktopClock" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </StandardDirectory>

    <!--Starts the clock after installing or upgrading, including silent installs. Started through Explorer so the clock gets the user's environment instead of the Windows Installer service's-->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[#DesktopClock.exe]&quot;" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
