<Window x:Class="DesktopClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopClock"
        xmlns:p="clr-namespace:DesktopClock.Properties"
        d:DataContext="{d:DesignInstance Type=local:SettingsWindowViewModel}"
        mc:Ignorable="d"
        Title="{local:Loc SettingsTitle}"
        Width="{Binding Source={x:Static p:Settings.Default}, Path=SettingsWindowWidth, Mode=TwoWay}"
        Height="{Binding Source={x:Static p:Settings.Default}, Path=SettingsWindowHeight, Mode=TwoWay}"
        MinWidth="800"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="8,0,20,4">
                    <TextBlock Text="DesktopClock"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                </StackPanel>

                <StackPanel x:Name="NavPanel"
                            Grid.Row="1">
                    <Button Content="{local:Loc NavDisplay}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=DisplaySection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavCountdown}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=CountdownSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavWindow}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=WindowSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavThemePresets}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=ThemeSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavTypography}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=TypographySection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavAppearance}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=AppearanceSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavAlerts}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=AlertsSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavShortcuts}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=ShortcutsSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavDiscoverMore}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=DiscoverMoreSection}"
                            Click="NavigateToSection" />
                    <Button Content="{local:Loc NavCredits}"
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding ElementName=CreditsSection}"
                            Click="NavigateToSection" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SidebarToolButton}"
                            Click="OpenSettingsFolder"
                            IsEnabled="{x:Static p:Settings.CanBeSaved}">
                        <StackPanel>
                            <AccessText FontWeight="SemiBold"
                                        Text="{local:Loc SettingsFolder}" />
                            <TextBlock Text="{local:Loc SettingsFolderDescription}"
                                       Style="{StaticResource SidebarToolDescription}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarToolButton}"
                            Click="OpenSettingsFile"
                            IsEnabled="{x:Static p:Settings.CanBeSaved}">
                        <StackPanel>
                            <AccessText FontWeight="SemiBold"
                                        Text="{local:Loc SettingsFile}" />
                            <TextBlock Text="{local:Loc SettingsFileDescription}"
                                       Style="{StaticResource SidebarToolDescription}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarToolButton}"
                            Click="CreateNewClock"
                            IsEnabled="{x:Static p:Settings.CanBeSaved}">
                        <StackPanel>
                            <AccessText FontWeight="SemiBold"
                                        Text="{local:Loc NewClock}" />
                            <TextBlock Text="{local:Loc NewClockDescription}"
                                       Style="{StaticResource SidebarToolDescription}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="SettingsScrollViewer_ScrollChanged"
                      Loaded="SettingsScrollViewer_Loaded">
            <StackPanel x:Name="SettingsContent"
                        Margin="24,24,24,0">
            <GroupBox x:Name="DisplaySection"
                      Header="{local:Loc SectionDisplay}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <TextBlock Text="{local:Loc ClockFormat}"
                               Style="{StaticResource LabelTextBlock}" />
                    <local:FormatEditor Mode="Clock" />
                    <TextBlock Style="{StaticResource DescriptionTextBlock}"
                               Margin="0,0,0,16">
                        <Run Text="{local:Loc ClockFormatDescription}" />
                        <Hyperlink NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{local:Loc LearnMore}" />
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="{local:Loc TimeZone}"
                               Style="{StaticResource LabelTextBlock}" />
                    <ComboBox ItemsSource="{Binding TimeZones}"
                              SelectedItem="{Binding Settings.TimeZoneInfo, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Text="{local:Loc TimeZoneDescription}"
                               Style="{StaticResource DescriptionTextBlock}" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="CountdownSection"
                      Header="{local:Loc SectionCountdown}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <TextBlock Text="{local:Loc CountdownTarget}"
                               Style="{StaticResource LabelTextBlock}" />
                    <local:CountdownTargetEditor />
                    <TextBlock Text="{local:Loc CountdownTargetDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc CountdownFormat}"
                               Style="{StaticResource LabelTextBlock}" />
                    <local:FormatEditor Mode="Countdown" />
                    <TextBlock Style="{StaticResource DescriptionTextBlock}">
                        <Run Text="{local:Loc CountdownFormatDescription}" />
                        <Hyperlink NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-timespan-format-strings"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{local:Loc LearnMore}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="WindowSection"
                      Header="{local:Loc SectionWindow}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <CheckBox Content="{local:Loc StartWithWindows}"
                              IsChecked="{Binding Settings.RunOnStartup, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc StartWithWindowsDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc ShowInTaskbar}"
                              IsChecked="{Binding Settings.ShowInTaskbar, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc ShowInTaskbarDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc HideFromAltTab}"
                              IsChecked="{Binding Settings.HideFromAltTab, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc HideFromAltTabDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc AlwaysOnTop}"
                              IsChecked="{Binding Settings.Topmost, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc AlwaysOnTopDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc ClickThrough}"
                              IsChecked="{Binding Settings.ClickThrough, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc ClickThroughDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc HideWhenFullscreen}"
                              IsChecked="{Binding Settings.HideWhenFullscreen, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc HideWhenFullscreenDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc StartHidden}"
                              IsChecked="{Binding Settings.StartHidden, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc StartHiddenDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc AllowDragging}"
                              IsChecked="{Binding Settings.DragToMove, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc AllowDraggingDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc AlignRight}"
                              IsChecked="{Binding Settings.RightAligned, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc AlignRightDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc PixelShifting}"
                              IsChecked="{Binding Settings.BurnInMitigation, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc PixelShiftingDescription}"
                               Style="{StaticResource DescriptionTextBlock}" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ThemeSection"
                      Header="{local:Loc SectionThemePresets}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <local:ThemePresetPicker />
                    <TextBlock Text="{local:Loc ThemePresetsDescription}"
                               Style="{StaticResource DescriptionTextBlock}" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="TypographySection"
                      Header="{local:Loc SectionTypography}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <TextBlock Text="{local:Loc FontFamily}"
                               Style="{StaticResource LabelTextBlock}" />
                    <ComboBox ItemsSource="{Binding FontFamilies}"
                              SelectedItem="{Binding Settings.FontFamily, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc FontFamilyDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc FontStyle}"
                               Style="{StaticResource LabelTextBlock}" />
                    <ComboBox ItemsSource="{Binding FontStyles}"
                              SelectedValue="{Binding Settings.FontStyle, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="{local:Loc FontStyleDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc FontWeight}"
                               Style="{StaticResource LabelTextBlock}" />
                    <ComboBox ItemsSource="{Binding FontWeights}"
                              SelectedValue="{Binding Settings.FontWeight, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="{local:Loc FontWeightDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc TextColor}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Settings.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ColorSwatchButton}"
                                ToolTip="{local:Loc TextColorPick}"
                                Click="PickTextColor">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="3"
                                    BorderBrush="#66000000"
                                    BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Settings.TextColor}" />
                                </Border.Background>
                            </Border>
                        </Button>
                    </Grid>
                    <TextBlock Text="{local:Loc TextColorDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc TextOpacity}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Margin="0"
                                Value="{Binding Settings.TextOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0"
                                Maximum="1"
                                TickFrequency="0.01"
                                IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Settings.TextOpacity, StringFormat=0.00}"
                                   Style="{StaticResource SliderValueTextBlock}" />
                    </Grid>
                    <TextBlock Text="{local:Loc TextOpacityDescription}"
                               Style="{StaticResource DescriptionTextBlock}" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="AppearanceSection"
                      Header="{local:Loc SectionAppearance}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <TextBlock Text="{local:Loc OuterColor}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Settings.OuterColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ColorSwatchButton}"
                                ToolTip="{local:Loc OuterColorPick}"
                                Click="PickOuterColor">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="3"
                                    BorderBrush="#66000000"
                                    BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Settings.OuterColor}" />
                                </Border.Background>
                            </Border>
                        </Button>
                    </Grid>
                    <TextBlock Text="{local:Loc OuterColorDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc SolidBackground}"
                              IsChecked="{Binding Settings.BackgroundEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc SolidBackgroundDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc BackgroundOpacity}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Margin="0"
                                Value="{Binding Settings.BackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0"
                                Maximum="1"
                                TickFrequency="0.01"
                                IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Settings.BackgroundOpacity, StringFormat=0.00}"
                                   Style="{StaticResource SliderValueTextBlock}" />
                    </Grid>
                    <TextBlock Text="{local:Loc BackgroundOpacityDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc RoundedCorners}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Margin="0"
                                Value="{Binding Settings.BackgroundCornerRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0"
                                Maximum="24"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Settings.BackgroundCornerRadius, StringFormat=0.0}"
                                   Style="{StaticResource SliderValueTextBlock}" />
                    </Grid>
                    <TextBlock Text="{local:Loc RoundedCornersDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc OutlineThickness}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Margin="0"
                                Value="{Binding Settings.OutlineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0"
                                Maximum="5"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Settings.OutlineThickness, StringFormat=0.0}"
                                   Style="{StaticResource SliderValueTextBlock}" />
                    </Grid>
                    <TextBlock Text="{local:Loc OutlineThicknessDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc BackgroundImage}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Settings.BackgroundImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Content="{local:Loc Browse}"
                                Click="BrowseBackgroundImagePath" />
                        <Button Grid.Column="4"
                                Content="{local:Loc Reset}"
                                Command="{Binding ResetBackgroundImagePathCommand}" />
                    </Grid>
                    <TextBlock Text="{local:Loc BackgroundImageDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc ImageFit}"
                               Style="{StaticResource LabelTextBlock}" />
                    <ComboBox ItemsSource="{Binding ImageStretches}"
                              SelectedValue="{Binding Settings.BackgroundImageStretch, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="{local:Loc ImageFitDescription}"
                               Style="{StaticResource DescriptionTextBlock}" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="AlertsSection"
                      Header="{local:Loc SectionAlerts}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <TextBlock Text="{local:Loc AlarmSound}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Settings.WavFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Content="{local:Loc Browse}"
                                Click="BrowseWavFilePath" />
                        <Button Grid.Column="4"
                                Content="{local:Loc Reset}"
                                Command="{Binding ResetWavFilePathCommand}" />
                    </Grid>
                    <TextBlock Text="{local:Loc AlarmSoundDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <TextBlock Text="{local:Loc SoundInterval}"
                               Style="{StaticResource LabelTextBlock}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Settings.WavFileInterval, Mode=TwoWay}" />
                        <Button Grid.Column="2"
                                Content="{local:Loc Reset}"
                                Command="{Binding ResetWavFileIntervalCommand}" />
                    </Grid>
                    <TextBlock Text="{local:Loc SoundIntervalDescription}"
                               Margin="0,0,0,16"
                               Style="{StaticResource DescriptionTextBlock}" />

                    <CheckBox Content="{local:Loc PlaySoundOnCountdown}"
                              IsChecked="{Binding Settings.PlaySoundOnCountdown, Mode=TwoWay}" />
                    <TextBlock Text="{local:Loc PlaySoundOnCountdownDescription}"
                               Style="{StaticResource DescriptionTextBlock}" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ShortcutsSection"
                      Header="{local:Loc SectionShortcuts}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <StackPanel>
                        <TextBlock>
                            <Run FontWeight="SemiBold"
                                 Text="{local:Loc ShortcutRightClick}" />
                            <Run Text="{local:Loc ShortcutRightClickAction}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="SemiBold"
                                 Text="{local:Loc ShortcutDoubleClick}" />
                            <Run Text="{local:Loc ShortcutDoubleClickAction}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="SemiBold"
                                 Text="{local:Loc ShortcutDrag}" />
                            <Run Text="{local:Loc ShortcutDragAction}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="SemiBold"
                                 Text="{local:Loc ShortcutCtrlScroll}" />
                            <Run Text="{local:Loc ShortcutCtrlScrollAction}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="SemiBold"
                                 Text="{local:Loc ShortcutCtrlPlus}" />
                            <Run Text="{local:Loc ShortcutCtrlPlusAction}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="SemiBold"
                                 Text="{local:Loc ShortcutCtrlMinus}" />
                            <Run Text="{local:Loc ShortcutCtrlMinusAction}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="DiscoverMoreSection"
                      Header="{local:Loc SectionDiscoverMore}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <StackPanel>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://play.google.com/store/apps/details?id=com.danielchalmers.journalapp"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Good Diary
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{local:Loc GoodDiaryDescription}"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DescriptionTextBlock}" />
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/danielchalmers/Network-Monitor"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Network Monitor
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{local:Loc NetworkMonitorDescription}"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DescriptionTextBlock}" />
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/danielchalmers/SentryReplay"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Sentry Replay
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{local:Loc SentryReplayDescription}"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DescriptionTextBlock}" />
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/danielchalmers/RadialActions"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Radial Actions
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{local:Loc RadialActionsDescription}"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DescriptionTextBlock}" />
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/danielchalmers/Teichos"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Teichos
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{local:Loc TeichosDescription}"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DescriptionTextBlock}" />
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/danielchalmers"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{local:Loc MoreFromDeveloper}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="CreditsSection"
                      Header="{local:Loc SectionCredits}"
                      Style="{StaticResource CardGroupBox}">
                <StackPanel Style="{StaticResource CardBodyPanel}">
                    <StackPanel>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/CommunityToolkit/dotnet"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                CommunityToolkit
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/Fody/Costura"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Costura.Fody
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/HavenDV/H.NotifyIcon"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                H.NotifyIcon.Wpf
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://www.newtonsoft.com/json"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Newtonsoft.Json
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/Fody/PropertyChanged"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                PropertyChanged.Fody
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/danielchalmers/WpfWindowPlacement"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                WpfWindowPlacement
                            </Hyperlink>
                        </TextBlock>
